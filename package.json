{
  "name": "toko-online-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo Toko Online (Express Backend + React Frontend)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "build": "npm run build --workspace=frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
